<Window x:Class="QpcrPrimerStudio.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:QpcrPrimerStudio.Desktop"
 Title="qPCR Primer Studio" Width="1440" Height="900" MinWidth="1080" MinHeight="700"
 Background="{DynamicResource CanvasBrush}" WindowStartupLocation="CenterScreen" Icon="Assets/app.ico"
 WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True">
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="54" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="8" UseAeroCaptionButtons="False" /></WindowChrome.WindowChrome>
 <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility" /></Window.Resources>
 <Window.InputBindings><KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenProjectCommand}" /><KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProjectCommand}" /></Window.InputBindings>
 <Grid x:Name="WindowSurface" Background="{DynamicResource ShellBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="32" /></Grid.RowDefinitions>
  <Border x:Name="HeaderBar" Height="54" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,4,6,4">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <Grid x:Name="HeaderDragArea" Background="Transparent"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image x:Name="HeaderLogo" Width="36" Height="36" Margin="0,0,10,0" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="HighQuality"><Image.Source><BitmapImage UriSource="Assets/app.png" DecodePixelWidth="144" CacheOption="OnLoad" /></Image.Source></Image><StackPanel><TextBlock x:Name="HeaderTitleText" Text="一二 qPCR Primer Studio" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="SYBR Green · 基因表达" Style="{StaticResource Caption}" FontSize="11" /></StackPanel></StackPanel></Grid>
    <StackPanel x:Name="ProjectActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,28,0" WindowChrome.IsHitTestVisibleInChrome="True">
     <Menu Background="Transparent" VerticalAlignment="Center" Margin="0,0,12,0"><MenuItem Header="项目"><MenuItem Header="新建项目" Command="{Binding NewProjectCommand}" /><MenuItem Header="打开项目…" Command="{Binding OpenProjectCommand}" /><MenuItem Header="保存项目" Command="{Binding SaveProjectCommand}" /><MenuItem Header="恢复最近自动保存" Command="{Binding RecoverAutoSaveCommand}" /><Separator /><MenuItem Header="查看引物库" Command="{Binding LibraryCommand}" /><MenuItem Header="切换深浅主题" Command="{Binding ToggleThemeCommand}" /></MenuItem></Menu>
     <Button Content="保存" Command="{Binding SaveProjectCommand}" Margin="0,0,8,0" /><Button Content="导出 Excel / CSV" Command="{Binding ExportCommand}" Margin="0,0,8,0" /><Button x:Name="HelpButton" Content="帮助" ToolTip="使用指南与参数说明（F1）" Click="OpenHelp" Margin="0" />
    </StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
     <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" ToolTip="最小化" AutomationProperties.Name="最小化窗口" Click="MinimizeWindow"><Path Data="M0,0 L12,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Width="12" Height="1" Stretch="Fill" /></Button>
     <Button x:Name="MaximizeButton" AutomationProperties.Name="最大化或还原窗口" Click="MaximizeRestoreWindow">
      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource CaptionButton}"><Setter Property="ToolTip" Value="最大化" /><Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="ToolTip" Value="还原" /></DataTrigger></Style.Triggers></Style></Button.Style>
      <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="12" Height="12" Stretch="Uniform"><Path.Style><Style TargetType="Path"><Setter Property="Data" Value="M1,1 H11 V11 H1 Z" /><Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Data" Value="M1,4 H8 V11 H1 Z M4,4 V1 H11 V8 H8" /></DataTrigger></Style.Triggers></Style></Path.Style></Path>
     </Button>
     <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}" ToolTip="关闭" AutomationProperties.Name="关闭窗口" Click="CloseWindow"><Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Width="10" Height="10" Stretch="Fill" /></Button>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1" Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Padding="12">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
     <TextBlock Text="项目靶标" Style="{StaticResource SectionTitle}" />
     <StackPanel Grid.Row="1"><Button Content="导入序列…" Command="{Binding ImportCommand}" HorizontalAlignment="Stretch" ToolTip="导入 FASTA / GenBank" /><Button Content="添加序列" Command="{Binding AddTargetCommand}" HorizontalAlignment="Stretch" /></StackPanel>
     <ListBox x:Name="TargetList" Grid.Row="2" ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" ItemContainerStyle="{StaticResource TargetListItem}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,8">
      <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="2,6"><TextBlock Text="{Binding Id}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" FontSize="11" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <StackPanel Grid.Row="3"><Expander Header="任务记录" IsExpanded="False" Margin="0,4,0,4"><ListBox x:Name="RunHistoryList" ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}" Height="100" BorderThickness="0" Background="Transparent" /></Expander><Button x:Name="RetryFailedButton" Content="重新设计失败靶标" ToolTip="仅对失败靶标重新运行，保留已完成结果" Command="{Binding RetryFailedCommand}" HorizontalAlignment="Stretch" /><Button x:Name="RelaxCurrentButton" Content="放宽条件重试当前" ToolTip="对当前靶标放宽部分约束并生成新任务，保留原任务记录" Command="{Binding RelaxCurrentCommand}" HorizontalAlignment="Stretch" /></StackPanel>
     <StackPanel Grid.Row="4"><TextBlock x:Name="AutoSaveStatusText" Text="{Binding AutoSaveStatus}" Style="{StaticResource Caption}" FontSize="11" TextWrapping="Wrap" /><TextBlock Text="{Binding ProjectPath}" Style="{StaticResource Caption}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProjectPath}" /><TextBlock Text="{Binding BackupSummary}" Style="{StaticResource Caption}" FontSize="11" /><Button Content="查看 / 恢复备份" Command="{Binding ManageBackupsCommand}" /></StackPanel>
    </Grid>
   </Border>
   <TabControl x:Name="WorkspaceTabs" Grid.Column="2" ItemContainerStyle="{StaticResource WorkspaceTab}" Background="Transparent" BorderThickness="0">
    <TabItem Header="设计工作台"><local:WorkbenchView /></TabItem>
    <TabItem Header="设计条件" Visibility="{Binding AdvancedMode, Converter={StaticResource BoolVisibility}}"><local:DesignSettingsView /></TabItem>
    <TabItem Header="参考与特异性"><local:ReferenceView /></TabItem>
   </TabControl>
  </Grid>
  <Border Grid.Row="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="18,5">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"><TextBlock Text="任务进行中" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,8,0" /><ProgressBar x:Name="TaskProgress" Width="130" Height="6" Minimum="0" Maximum="100" Value="{Binding Progress}" IsIndeterminate="{Binding IsBusy}" /></StackPanel></Grid>
  </Border>
 </Grid>
</Window>
