<UserControl x:Class="QpcrPrimerStudio.Desktop.WorkbenchView" x:Name="WorkbenchSurface"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:QpcrPrimerStudio.Desktop" FontWeight="Normal">
 <UserControl.Resources><local:CandidateListConverter x:Key="CandidateList" /><local:CandidateMismatchConverter x:Key="CandidateMismatch" /><local:WideWorkbenchConverter x:Key="WideWorkbench" /><Style x:Key="ScoreCell" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="TextAlignment" Value="Center" /><Setter Property="ToolTip" Value="综合评分，范围 0–100；质量报告显示评分依据与证据覆盖。" /></Style><Style x:Key="AdaptiveCell" TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" /></Style></UserControl.Resources>
 <Grid Margin="0,6,0,0">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="6" /><RowDefinition Height="*" /></Grid.RowDefinitions>
  <Grid x:Name="DesignToolbar" Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <TextBlock Text="引物设计" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,4" />
   <TextBlock Grid.Column="1" Text="搜索条件 → 候选结果 → 编辑 → 分析 / 应用" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,16,4" ToolTip="导入序列后点 Search，确认条件；Results 选择候选；Edit Primers 修改后点 Analyze，再 Apply。" />
   <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><CheckBox x:Name="ProfessionalModeToggle" Content="专业模式" IsChecked="{Binding AdvancedMode}" VerticalAlignment="Center" Margin="0,0,8,4" ToolTip="默认使用简单模式；勾选后显示完整设计条件、属性面板和实验记录。切换保留参数与结果。" /><Button Content="暂停 / 继续" Command="{Binding PauseResumeCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" /><Button Content="取消" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" /></StackPanel>
  </Grid>
  <Border Grid.Row="1" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <Expander Header="靶标序列与引物输入" IsExpanded="{Binding InputExpanded}">
    <TabControl Margin="0,4,0,0" BorderThickness="0" SelectedIndex="{Binding InputTabIndex}">
     <TabItem Header="靶标序列" ToolTip="用于设计引物的转录本或 cDNA 序列"><Grid Margin="0,4,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="100" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="靶标 ID" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBox Grid.Column="1" Text="{Binding TargetName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,8,6" /><TextBlock Grid.Column="2" Text="连接位点" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBox Grid.Column="3" Text="{Binding JunctionText}" Margin="0,2,8,6" ToolTip="cDNA 前一外显子末位坐标，多个位置用逗号分隔，例如 120,260" /><Button Grid.Column="4" Content="保存序列" Command="{Binding ApplyTemplateCommand}" /></Grid>
      <TextBox x:Name="TargetSequenceInput" Grid.Row="1" Height="100" Text="{Binding TemplateText, UpdateSourceTrigger=PropertyChanged}" local:SequenceInputFocus.ErrorOffset="{Binding TemplateErrorOffset}" FontFamily="Cascadia Mono, Consolas" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" ToolTip="粘贴 DNA 序列，允许空格与换行。选中 15–36 nt 后右键可构建 F 或 R；R 自动取反向互补。"><TextBox.ContextMenu><ContextMenu><MenuItem Header="选区作为 Forward · F" Click="SelectForward" /><MenuItem Header="选区作为 Reverse · R（反向互补）" Click="SelectReverse" /><Separator /><MenuItem Command="ApplicationCommands.Copy" /><MenuItem Command="ApplicationCommands.Paste" /><MenuItem Command="ApplicationCommands.SelectAll" /></ContextMenu></TextBox.ContextMenu></TextBox>
      <TextBlock x:Name="TemplateInputFeedback" Grid.Row="2" Text="{Binding TemplateInputError}" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding TemplateInputError}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </Grid></TabItem>
     <TabItem Header="Edit Primers · 编辑引物"><Grid Margin="0,4,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <StackPanel><TextBlock Text="Forward 5′→3′" /><TextBox Text="{Binding ManualForward, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"><TextBox.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><MenuItem Header="反向互补" Command="{Binding TransformPrimerCommand}" CommandParameter="F:ReverseComplement" /><MenuItem Header="仅反向" Command="{Binding TransformPrimerCommand}" CommandParameter="F:Reverse" /><MenuItem Header="仅互补" Command="{Binding TransformPrimerCommand}" CommandParameter="F:Complement" /></ContextMenu></TextBox.ContextMenu></TextBox></StackPanel><StackPanel Grid.Row="1"><TextBlock Text="Reverse 5′→3′" /><TextBox Text="{Binding ManualReverse, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"><TextBox.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><MenuItem Header="反向互补" Command="{Binding TransformPrimerCommand}" CommandParameter="R:ReverseComplement" /><MenuItem Header="仅反向" Command="{Binding TransformPrimerCommand}" CommandParameter="R:Reverse" /><MenuItem Header="仅互补" Command="{Binding TransformPrimerCommand}" CommandParameter="R:Complement" /></ContextMenu></TextBox.ContextMenu></TextBox></StackPanel>
      <WrapPanel Grid.Row="2"><Button Content="Analyze · 分析" Command="{Binding AnalyzeManualCommand}" Style="{StaticResource Primary}" ToolTip="修改后先计算引物自身的 Tm、GC、结构与 ΔG；可分析模板错配序列。" /><Button Content="Apply · 应用重算" Command="{Binding EvaluateCommand}" ToolTip="与模板重新核对结合坐标、产物与特异性，保存为新修订；原结果保留。" /><Button Content="Search · 寻找配对" Command="{Binding ConfigureCompatibleSearchCommand}" ToolTip="选择 Compatible with Sense 或 Anti-sense，为当前固定引物寻找配对。" /></WrapPanel>
      <StackPanel Grid.Row="3"><TextBlock Text="{Binding EditSummary}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,4" /><TextBox Text="{Binding EditorAnalysisText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" MaxHeight="90" VerticalScrollBarVisibility="Auto"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Style.Triggers><DataTrigger Binding="{Binding EditorAnalysisText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox></StackPanel>
     </Grid></TabItem>
    </TabControl>
   </Expander>
   <Grid Grid.Row="1" Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <TextBlock Text="预期转录本" VerticalAlignment="Center" Margin="0,0,6,0" /><TextBox x:Name="ExpectedTranscriptsInput" Grid.Column="1" Text="{Binding ExpectedText}" MinWidth="60" Margin="0,2,8,2" VerticalAlignment="Center" ToolTip="多个转录本 ID 用逗号分隔。" />
    <StackPanel x:Name="DesignActions" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><StackPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="8,4" /><Setter Property="Margin" Value="0,0,4,0" /><Setter Property="FontSize" Value="12" /></Style></StackPanel.Resources><Button x:Name="DesignCurrentButton" Content="Search · 搜索" Command="{Binding ConfigureSearchCommand}" Style="{StaticResource Primary}" Padding="8,4" FontSize="12" Margin="0,0,4,0" /><Button Content="结果" Command="{Binding ShowResultsCommand}" ToolTip="Results · 查看候选结果" /><Button Content="编辑" Command="{Binding EditSelectedCommand}" ToolTip="Edit Primers · 编辑选中引物" /><Button Content="批量设计" Command="{Binding DesignAllCommand}" Margin="0" /></StackPanel>
   </Grid>
  </Grid></Border>
  <Border Grid.Row="3" Style="{StaticResource Card}">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <WrapPanel><TextBlock Text="设计结果" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0,0,16,4" /><TextBlock x:Name="SelectedScoreText" Text="{Binding SelectedCandidate.Assessment.Score, StringFormat=选中评分 {0:F1} / 100, TargetNullValue=选中评分 —}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,4" ToolTip="综合评分按已完成的检查计算；在质量报告查看评分依据与证据覆盖。" /><Button x:Name="ScreenHairpinsButton" Content="排除高风险发卡" Command="{Binding ScreenHairpinsCommand}" ToolTip="按实际退火温度、发卡 Tm、3′末端配对及 ΔG 筛选。右键可设置阈值或清除筛选。"><Button.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><MenuItem Header="设置筛选条件…" Command="{Binding ConfigureHairpinScreeningCommand}" /><MenuItem Header="清除筛选，恢复全部" Command="{Binding ClearHairpinScreeningCommand}" /></ContextMenu></Button.ContextMenu></Button><CheckBox Content="显示已排除" IsChecked="{Binding ShowHairpinExcluded}" Visibility="{Binding HasHairpinScreening, Converter={StaticResource BoolVisibility}}" VerticalAlignment="Center" Margin="8,0,8,4" /><Button Content="收藏" Command="{Binding FavoriteCommand}" Visibility="{Binding AdvancedMode, Converter={StaticResource BoolVisibility}}" /><Button Content="锁定候选" Command="{Binding LockCandidateCommand}" Visibility="{Binding AdvancedMode, Converter={StaticResource BoolVisibility}}" /><CheckBox Content="仅导出勾选项" IsChecked="{Binding SelectedOnly}" VerticalAlignment="Center" Margin="8,0,0,4" /></WrapPanel>
    <StackPanel Grid.Row="1"><WrapPanel><Button x:Name="SmartExportButton" Content="智能导出 · 每基因一对" Command="{Binding SmartExportCommand}" ToolTip="核对各基因当前模板最近一次设计，排除高风险发卡后选择综合评分最高的一对，并列出未导出原因。" /><TextBlock x:Name="ResultContextText" Text="{Binding ResultContext}" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="8,0,0,4" /></WrapPanel><TextBlock Text="{Binding HairpinFilterSummary}" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Style.Triggers><DataTrigger Binding="{Binding HairpinFilterSummary}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
    <TabControl Grid.Row="2" Margin="0,4,0,0" BorderThickness="0" SelectedIndex="{Binding ResultsTabIndex}">
     <TabItem Header="候选表"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><DataGrid x:Name="CandidateGrid" ItemsSource="{Binding CandidateView}" SelectedItem="{Binding SelectedCandidate}" SelectionMode="Single" CanUserSortColumns="True" ColumnWidth="Auto" MinColumnWidth="32" RowHeight="54" FrozenColumnCount="3" RowDetailsVisibilityMode="VisibleWhenSelected" local:AdaptiveCandidateColumns.Enabled="True" local:AdaptiveCandidateColumns.ProfessionalMode="{Binding AdvancedMode}" MouseDoubleClick="CandidateDoubleClick">
      <DataGrid.Columns>
       <DataGridTemplateColumn Header="选" SortMemberPath="Selected" Width="32" IsReadOnly="True"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox x:Name="CandidateSelectionCheckBox" IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" SourceUpdated="SaveCandidateSelection" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0" ToolTip="勾选或取消勾选后自动保存项目"><CheckBox.Style><Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Style.Triggers><DataTrigger Binding="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType={x:Type local:WorkbenchView}}}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></CheckBox.Style></CheckBox></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn Header="#" Binding="{Binding Rank}" IsReadOnly="True" />
       <DataGridTextColumn Header="评分" Binding="{Binding Assessment.Score, StringFormat=F1, TargetNullValue=—}" ElementStyle="{StaticResource ScoreCell}" IsReadOnly="True" CanUserReorder="False" />
       <DataGridTemplateColumn Header="Forward 5′→3′" SortMemberPath="Forward.Sequence" IsReadOnly="True" Width="2*" MinWidth="210"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="4,2"><TextBlock Text="{Binding Forward.Sequence}" FontFamily="Consolas" FontSize="12" /><TextBlock Text="{Binding Forward, Converter={StaticResource CandidateList}, ConverterParameter=Metrics}" FontSize="11" Foreground="{DynamicResource MutedBrush}" /><TextBlock Text="{Binding Forward.HairpinTm, StringFormat=发卡 Tm {0:F1} °C}" FontSize="11" Foreground="{DynamicResource MutedBrush}" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn Header="Reverse 5′→3′" SortMemberPath="Reverse.Sequence" IsReadOnly="True" Width="2*" MinWidth="210"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="4,2"><TextBlock Text="{Binding Reverse.Sequence}" FontFamily="Consolas" FontSize="12" /><TextBlock Text="{Binding Reverse, Converter={StaticResource CandidateList}, ConverterParameter=Metrics}" FontSize="11" Foreground="{DynamicResource MutedBrush}" /><TextBlock Text="{Binding Reverse.HairpinTm, StringFormat=发卡 Tm {0:F1} °C}" FontSize="11" Foreground="{DynamicResource MutedBrush}" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTemplateColumn Header="错配 F / R" IsReadOnly="True" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Margin="4,2" FontSize="11" ToolTip="模板：与本次任务的输入序列逐位核对；数据库：与参考库比对。3′ 为末端 5 nt 的错配。"><TextBlock.Text><MultiBinding Converter="{StaticResource CandidateMismatch}"><Binding /><Binding Path="DataContext.SelectedRun.Target" RelativeSource="{RelativeSource AncestorType={x:Type local:WorkbenchView}}" /></MultiBinding></TextBlock.Text></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn Header="产物 bp" Binding="{Binding ProductLength}" IsReadOnly="True" />
       <DataGridTextColumn Header="特异性" Binding="{Binding SpecificitySummary}" IsReadOnly="True" Width="*" MinWidth="100" ElementStyle="{StaticResource AdaptiveCell}" />
       <DataGridTextColumn Header="证据%" Binding="{Binding Assessment.EvidenceCoverage, StringFormat=F0}" IsReadOnly="True" />
       <DataGridTextColumn Header="保留" Binding="{Binding Assessment.Accepted}" IsReadOnly="True" />
       <DataGridTextColumn Header="gDNA" Binding="{Binding Assessment.Gdna.Level}" IsReadOnly="True" />
       <DataGridTextColumn Header="靶标" Binding="{Binding TargetId}" IsReadOnly="True" Width="*" MinWidth="80" ElementStyle="{StaticResource AdaptiveCell}" />
       <DataGridTextColumn Header="Penalty" Binding="{Binding Penalty, StringFormat=F3}" IsReadOnly="True" />
      </DataGrid.Columns>
      <DataGrid.RowDetailsTemplate><DataTemplate><Border Background="{DynamicResource CanvasBrush}" Padding="8,4"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Forward 发卡结构" FontSize="11" FontWeight="SemiBold" /><TextBox Text="{Binding Forward.HairpinStructure, Converter={StaticResource CandidateList}, ConverterParameter=Structure}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" MaxHeight="74" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,2,0,0" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Reverse 发卡结构" FontSize="11" FontWeight="SemiBold" /><TextBox Text="{Binding Reverse.HairpinStructure, Converter={StaticResource CandidateList}, ConverterParameter=Structure}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" MaxHeight="74" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,2,0,0" /></StackPanel></Grid></Border></DataTemplate></DataGrid.RowDetailsTemplate>
     </DataGrid><local:CandidateInspectorView x:Name="CandidateInspector" Grid.Column="1" Width="300" Margin="10,0,0,0"><local:CandidateInspectorView.Visibility><MultiBinding Converter="{StaticResource WideWorkbench}"><Binding Path="ActualWidth" ElementName="WorkbenchSurface" /><Binding Path="ActualHeight" ElementName="CandidateGrid" /><Binding Path="AdvancedMode" /></MultiBinding></local:CandidateInspectorView.Visibility></local:CandidateInspectorView></Grid></TabItem>
     <TabItem Header="单引物搜索"><local:SinglePrimerResultsView /></TabItem>
     <TabItem Header="序列定位"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="125" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <WrapPanel Margin="0,6,0,4"><TextBlock Text="1-based 坐标 · 绿色 Forward · 紫色 Reverse" Style="{StaticResource Caption}" VerticalAlignment="Center" /><TextBlock Text="缩放" Margin="16,0,8,0" VerticalAlignment="Center" /><Slider Width="100" Minimum="1" Maximum="8" Value="{Binding SequenceZoom}" /></WrapPanel>
      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><local:SequenceTrack Target="{Binding DisplayTarget}" Candidate="{Binding SelectedCandidate}" Annotation="{Binding DisplayAnnotation}" Variants="{Binding DisplayVariants}" Zoom="{Binding SequenceZoom}" MinWidth="650" /></ScrollViewer>
      <TextBox Grid.Row="2" Text="{Binding SequenceContext}" IsReadOnly="True" FontFamily="Consolas" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
     </Grid></TabItem>
     <TabItem Header="质量报告"><TextBox Text="{Binding QualityText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" /></TabItem>
     <TabItem Header="结构分析"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><WrapPanel><Button Content="计算选中候选结构与 ΔG" Command="{Binding AnalyzeSelectedCommand}" Margin="0,8,8,6" /><ComboBox ItemsSource="{Binding OligoInspections}" SelectedItem="{Binding SelectedOligoInspection}" DisplayMemberPath="Summary" Width="210" ToolTip="已保存的手动序列分析记录" Margin="0,8,0,6" /></WrapPanel><TextBox Grid.Row="1" Text="{Binding StructureText}" FontFamily="Consolas" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" /></Grid></TabItem>
     <TabItem Header="特异性"><TextBox Text="{Binding EvidenceText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" /></TabItem>
     <TabItem Header="实验记录" Visibility="{Binding AdvancedMode, Converter={StaticResource BoolVisibility}}"><StackPanel Margin="0,12,0,0"><TextBlock Text="选中候选备注" /><TextBox Text="{Binding CandidateNotes}" AcceptsReturn="True" Height="90" VerticalScrollBarVisibility="Auto" /><WrapPanel><Button Content="保存备注" Command="{Binding NotesCommand}" /><Button Content="MIQE 实验记录" Command="{Binding RecordAssayCommand}" /></WrapPanel><TextBlock Text="记录实测效率、R²、熔解曲线、NTC、−RT、内参与重复数。" Style="{StaticResource Caption}" /></StackPanel></TabItem>
     <TabItem Header="任务日志" Visibility="{Binding AdvancedMode, Converter={StaticResource BoolVisibility}}"><TextBox Text="{Binding LogText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" /></TabItem>
    </TabControl>
   </Grid>
  </Border>
 </Grid>
</UserControl>
