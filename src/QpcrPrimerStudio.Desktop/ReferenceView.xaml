<UserControl x:Class="QpcrPrimerStudio.Desktop.ReferenceView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontWeight="Normal">
 <ScrollViewer Style="{StaticResource ReservedScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0">
  <StackPanel Margin="0,0,12,12">
   <TextBlock Text="参考与特异性" FontSize="19" FontWeight="SemiBold" /><TextBlock Text="管理物种参考项目，分别配置转录本和基因组特异性数据库。" Style="{StaticResource Caption}" Margin="0,4,0,16" />
   <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,16"><StackPanel>
    <TextBlock Text="物种参考项目" Style="{StaticResource SectionTitle}" /><WrapPanel><Button Content="建立参考项目" Command="{Binding ImportReferenceCommand}" /><Button Content="打开参考项目" Command="{Binding OpenReferenceCommand}" /><Button Content="按 Gene / Transcript 添加靶标" Command="{Binding AddReferenceTargetCommand}" /></WrapPanel>
    <TextBox Text="{Binding ReferenceSummary}" IsReadOnly="True" TextWrapping="Wrap" Height="150" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" />
   </StackPanel></Border>
   <Border Style="{StaticResource Card}" Padding="16"><StackPanel>
    <TextBlock Text="特异性数据库" Style="{StaticResource SectionTitle}" />
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><ComboBox SelectedItem="{Binding DatabaseKind}" ItemsSource="{Binding DatabaseKinds}" Margin="0,0,16,8" /><WrapPanel Grid.Column="1"><Button Content="建立数据库" Command="{Binding BuildDatabaseCommand}" /><Button Content="打开数据库" Command="{Binding OpenDatabaseCommand}" /></WrapPanel></Grid>
    <TextBlock Text="{Binding DatabaseSummary}" Style="{StaticResource Caption}" Margin="0,4,0,12" />
    <WrapPanel><Button Content="检查当前候选" Command="{Binding CheckCurrentCommand}" Style="{StaticResource Primary}" /><Button Content="检查全部" Command="{Binding CheckAllCommand}" /></WrapPanel>
    <Expander Header="错配与产物筛查条件" Margin="0,12,0,0"><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="总错配 / 末端 5 nt 错配上限" /><UniformGrid Columns="2"><TextBox Text="{Binding MaxMismatches}" Margin="0,4,8,12" /><TextBox Text="{Binding MaxThreePrimeMismatches}" Margin="0,4,0,12" /></UniformGrid></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="最大产物（bp） / 最大命中序列数" /><UniformGrid Columns="2"><TextBox Text="{Binding SpecificityMaxProduct}" Margin="0,4,8,12" /><TextBox Text="{Binding MaxSubjects}" Margin="0,4,0,12" /></UniformGrid></StackPanel>
    </Grid></Expander>
   </StackPanel></Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
