<Window x:Class="QpcrPrimerStudio.Desktop.SmartExportDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="智能导出预览" Width="940" Height="620" MinWidth="660" MinHeight="430" WindowStyle="None" ResizeMode="CanResize"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource CardBrush}">
 <Window.Resources>
  <Style x:Key="PreviewText" TargetType="TextBlock">
   <Setter Property="TextWrapping" Value="Wrap" /><Setter Property="VerticalAlignment" Value="Center" />
   <Setter Property="Margin" Value="3,3" />
  </Style>
 </Window.Resources>
 <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="智能导出 · 每个基因一对" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" /><Button x:Name="CloseDialogButton" Grid.Column="1" Content="关闭" IsCancel="True" shell:WindowChrome.IsHitTestVisibleInChrome="True" /></Grid>
   <StackPanel Grid.Row="1" Margin="0,0,0,8"><TextBlock x:Name="ExportSummary" TextWrapping="Wrap" FontWeight="SemiBold" />
    <Expander Header="筛选条件与同分排序" Margin="0,6,0,0"><TextBlock x:Name="ExportRules" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="8,4,8,6" /></Expander>
   </StackPanel>
   <TabControl x:Name="PreviewTabs" Grid.Row="2" BorderThickness="0">
    <TabItem Header="选出的引物"><DataGrid x:Name="SmartChoicesGrid" IsReadOnly="True" RowHeight="NaN" MinRowHeight="34" CanUserAddRows="False" AutoGenerateColumns="False"><DataGrid.Columns>
     <DataGridTextColumn Header="基因" Binding="{Binding Gene}" Width="*" MinWidth="90" ElementStyle="{StaticResource PreviewText}" />
     <DataGridTextColumn Header="靶标" Binding="{Binding Target}" Width="*" MinWidth="90" ElementStyle="{StaticResource PreviewText}" />
     <DataGridTextColumn Header="评分" Binding="{Binding Score, StringFormat=F1}" Width="46" />
     <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="33" />
     <DataGridTextColumn Header="转录本核对" Binding="{Binding TranscriptBinding}" Width="122" ElementStyle="{StaticResource PreviewText}" />
     <DataGridTextColumn Header="Forward 5′→3′" Binding="{Binding Forward5to3}" Width="2*" MinWidth="160" ElementStyle="{StaticResource PreviewText}" />
     <DataGridTextColumn Header="Reverse 5′→3′" Binding="{Binding Reverse5to3}" Width="2*" MinWidth="160" ElementStyle="{StaticResource PreviewText}" />
     <DataGridTextColumn Header="产物 bp" Binding="{Binding ProductBp}" Width="64" />
    </DataGrid.Columns></DataGrid></TabItem>
    <TabItem x:Name="MissingGenesTab" Header="未导出的基因"><DataGrid x:Name="SmartMissingGrid" IsReadOnly="True" RowHeight="NaN" MinRowHeight="34" CanUserAddRows="False" AutoGenerateColumns="False"><DataGrid.Columns>
     <DataGridTextColumn Header="基因" Binding="{Binding Gene}" Width="145" ElementStyle="{StaticResource PreviewText}" />
     <DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="*" MinWidth="360" ElementStyle="{StaticResource PreviewText}" />
    </DataGrid.Columns></DataGrid></TabItem>
    <TabItem Header="各靶标筛选记录"><DataGrid x:Name="SmartTargetsGrid" IsReadOnly="True" RowHeight="NaN" MinRowHeight="34" CanUserAddRows="False" AutoGenerateColumns="False" RowDetailsVisibilityMode="VisibleWhenSelected">
     <DataGrid.Columns>
      <DataGridTextColumn Header="基因" Binding="{Binding Gene}" Width="*" MinWidth="100" ElementStyle="{StaticResource PreviewText}" />
      <DataGridTextColumn Header="靶标" Binding="{Binding Target}" Width="*" MinWidth="100" ElementStyle="{StaticResource PreviewText}" />
      <DataGridTextColumn Header="原候选" Binding="{Binding Candidates}" Width="60" />
      <DataGridTextColumn Header="质量排除" Binding="{Binding QualityExcluded}" Width="72" />
      <DataGridTextColumn Header="无有效评分" Binding="{Binding Unscored}" Width="86" />
      <DataGridTextColumn Header="错配/未核对" Binding="{Binding MismatchExcluded}" Width="92" />
      <DataGridTextColumn Header="发卡排除" Binding="{Binding HairpinExcluded}" Width="72" />
      <DataGridTextColumn Header="保留" Binding="{Binding Retained}" Width="50" />
     </DataGrid.Columns>
     <DataGrid.RowDetailsTemplate><DataTemplate><Border Background="{DynamicResource CanvasBrush}" HorizontalAlignment="Left" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=DataGrid}}" Padding="10,6,26,6"><TextBlock Text="{Binding Reason}" TextWrapping="Wrap" /></Border></DataTemplate></DataGrid.RowDetailsTemplate>
    </DataGrid></TabItem>
   </TabControl>
   <DockPanel Grid.Row="3" Margin="0,10,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="取消" IsCancel="True" /><Button x:Name="ExportSmartButton" Content="导出 Excel / CSV…" IsDefault="True" Style="{StaticResource Primary}" Click="ConfirmExport" /></StackPanel><TextBlock Text="Excel 内含筛选记录；CSV 另附记录表。" Style="{StaticResource Caption}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" /></DockPanel>
  </Grid>
 </Border>
</Window>
