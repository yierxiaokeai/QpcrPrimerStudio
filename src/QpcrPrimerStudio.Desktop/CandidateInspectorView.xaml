<UserControl x:Class="QpcrPrimerStudio.Desktop.CandidateInspectorView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:QpcrPrimerStudio.Desktop">
 <UserControl.Resources><local:CandidateListConverter x:Key="CandidateList" /></UserControl.Resources>
 <Border Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,0,0,0" Padding="10,4,0,0">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
   <StackPanel><TextBlock Text="当前引物对" Style="{StaticResource SectionTitle}" /><TextBlock Text="{Binding SelectedCandidate.TargetId}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding SelectedCandidate.ProductLength, StringFormat=扩增子 {0} bp}" Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,4" /></StackPanel>
   <local:SequenceTrack Grid.Row="1" Target="{Binding DisplayTarget}" Candidate="{Binding SelectedCandidate}" Annotation="{Binding DisplayAnnotation}" Variants="{Binding DisplayVariants}" Height="80" Compact="True" />
   <TabControl Grid.Row="2" BorderThickness="0">
    <TabItem Header="属性"><ScrollViewer Style="{StaticResource ReservedScrollViewer}" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,4,4,0">
     <ItemsControl ItemsSource="{Binding SelectedCandidate, Converter={StaticResource CandidateList}, ConverterParameter=PropertyRows}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" /><TextBlock Grid.Column="1" Text="{Binding Forward}" TextAlignment="Right" /><TextBlock Grid.Column="2" Text="{Binding Reverse}" TextAlignment="Right" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <Separator /><TextBlock Text="{Binding SelectedCandidate.PairAnyTm, StringFormat=F–R 二聚体 ANY {0:F1} °C}" /><TextBlock Text="{Binding SelectedCandidate.PairEndTm, StringFormat=F–R 二聚体 3′ END {0:F1} °C}" />
     <TextBlock Text="{Binding SelectedCandidate.Assessment.Score, StringFormat=综合评分 {0:F1}}" Margin="0,6,0,0" /><TextBlock Text="{Binding SelectedCandidate.SpecificitySummary}" TextWrapping="Wrap" />
     <Button Content="Edit Primers · 编辑此对" Command="{Binding EditSelectedCommand}" Margin="0,8,0,4" HorizontalAlignment="Left" />
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="结构"><TextBox Text="{Binding StructureText}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" /></TabItem>
    <TabItem Header="特异性"><TextBox Text="{Binding EvidenceText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" /></TabItem>
    <TabItem Header="评分"><TextBox Text="{Binding QualityText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" /></TabItem>
   </TabControl>
  </Grid>
 </Border>
</UserControl>
